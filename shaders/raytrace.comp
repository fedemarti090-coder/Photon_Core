#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform writeonly image2D outImg;

struct Sphere {
    vec3 center;
    float radius;
    vec3 albedo;
};

float hitSphere(vec3 center, float radius, vec3 ro, vec3 rd) {
    vec3 oc = ro - center;
    float a = dot(rd, rd);
    float halfB = dot(oc, rd);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = halfB * halfB - a * c;

    if (discriminant < 0.0) {
        return -1.0;
    }

    float sqrtd = sqrt(discriminant);
    float t = (-halfB - sqrtd) / a;

    if (t > 0.001) {
        return t;
    }

    t = (-halfB + sqrtd) / a;
    if (t > 0.001) {
        return t;
    }

    return -1.0;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImg);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;
    ndc.x *= float(size.x) / float(size.y);

    vec3 ro = vec3(0.0, 0.0, 3.0);
    vec3 rd = normalize(vec3(ndc, -1.5));

    Sphere sphere = Sphere(vec3(0.0, 0.0, 0.0), 1.0, vec3(1.0, 0.42, 0.0));
    float t = hitSphere(sphere.center, sphere.radius, ro, rd);

    vec3 skyTop = vec3(0.12, 0.14, 0.22);
    vec3 skyBottom = vec3(0.03, 0.03, 0.05);
    float skyMix = clamp(0.5 * (rd.y + 1.0), 0.0, 1.0);
    vec3 color = mix(skyBottom, skyTop, skyMix);

    if (t > 0.0) {
        vec3 hitPoint = ro + rd * t;
        vec3 normal = normalize(hitPoint - sphere.center);
        vec3 lightDir = normalize(vec3(0.6, 0.8, 0.5)); // "Sole" luce diretta

        float diff = max(dot(normal, lightDir), 0.0);
        float ambient = 0.08;
        color = sphere.albedo * (diff + ambient);
    }

    imageStore(outImg, pixel, vec4(color, 1.0));
}