#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform writeonly image2D outImg;

struct Triangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 albedo;
};

layout(std430, binding = 1) readonly buffer TriangleBuffer {
    Triangle tris[];
};

float hitTriangle(Triangle tri, vec3 ro, vec3 rd) {
    const float EPSILON = 1e-6;

    vec3 p0 = tri.v0.xyz;
    vec3 p1 = tri.v1.xyz;
    vec3 p2 = tri.v2.xyz;

    vec3 edge1 = p1 - p0;
    vec3 edge2 = p2 - p0;

    vec3 h = cross(rd, edge2);
    float a = dot(edge1, h);

    if (abs(a) < EPSILON) {
        return -1.0;
    }

    float f = 1.0 / a;
    vec3 s = ro - p0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) {
        return -1.0;
    }

    vec3 q = cross(s, edge1);
    float v = f * dot(rd, q);
    if (v < 0.0 || u + v > 1.0) {
        return -1.0;
    }

    float t = f * dot(edge2, q);
    if (t > 0.001) {
        return t;
    }

    return -1.0;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImg);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;
    ndc.x *= float(size.x) / float(size.y);

    vec3 ro = vec3(0.0, 0.0, 3.0);
    vec3 rd = normalize(vec3(ndc, -1.5));

    vec3 skyTop = vec3(0.12, 0.14, 0.22);
    vec3 skyBottom = vec3(0.03, 0.03, 0.05);
    float skyMix = clamp(0.5 * (rd.y + 1.0), 0.0, 1.0);
    vec3 color = mix(skyBottom, skyTop, skyMix);

    uint triCount = tris.length();
    float closestT = 1e30;
    int hitIndex = -1;

    for (uint i = 0u; i < triCount; i++) {
        float t = hitTriangle(tris[i], ro, rd);
        if (t > 0.0 && t < closestT) {
            closestT = t;
            hitIndex = int(i);
        }
    }

    if (hitIndex != -1) {
        Triangle hitTri = tris[hitIndex];
        vec3 p0 = hitTri.v0.xyz;
        vec3 p1 = hitTri.v1.xyz;
        vec3 p2 = hitTri.v2.xyz;

        vec3 normal = normalize(cross(p1 - p0, p2 - p0));
        if (dot(normal, -rd) < 0.0) {
            normal = -normal;
        }

        vec3 lightDir = normalize(vec3(0.6, 0.8, 0.5));
        float diff = max(dot(normal, lightDir), 0.0);
        float ambient = 0.1;

        color = hitTri.albedo.rgb * (diff + ambient);
    }

    imageStore(outImg, pixel, vec4(color, 1.0));
}